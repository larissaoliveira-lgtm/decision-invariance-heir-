#!/usr/bin/env python3
"""Lightweight structural validation for distributed Jupyter notebooks.

This is a repository/publication utility and is not part of the frozen
scientific analysis. It deliberately does not execute notebook code.
"""
from __future__ import annotations
import argparse
import json
from pathlib import Path
import sys


def validate(path: Path, require_clean: bool) -> list[str]:
    errors: list[str] = []
    try:
        nb = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return [f"invalid JSON: {exc}"]
    if nb.get("nbformat") != 4:
        errors.append(f"expected nbformat 4, found {nb.get('nbformat')!r}")
    cells = nb.get("cells")
    if not isinstance(cells, list) or not cells:
        errors.append("cells must be a non-empty list")
        return errors
    for i, cell in enumerate(cells):
        if cell.get("cell_type") not in {"markdown", "code", "raw"}:
            errors.append(f"cell {i}: invalid cell_type {cell.get('cell_type')!r}")
        src = cell.get("source")
        if not isinstance(src, (str, list)):
            errors.append(f"cell {i}: source must be string or list")
        if cell.get("cell_type") == "code" and require_clean:
            if cell.get("outputs"):
                errors.append(f"cell {i}: execution outputs present")
            if cell.get("execution_count") is not None:
                errors.append(f"cell {i}: execution_count is not null")
    return errors


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("notebooks", nargs="+", type=Path)
    ap.add_argument("--require-clean", action="store_true")
    args = ap.parse_args()
    failed = False
    for p in args.notebooks:
        errs = validate(p, args.require_clean)
        if errs:
            failed = True
            print(f"FAIL {p}")
            for e in errs:
                print(f"  - {e}")
        else:
            print(f"OK   {p}")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(2)
